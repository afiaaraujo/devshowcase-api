generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// 1. Entidade Profile (Perfil do Desenvolvedor)
model Profile {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  bio       String?
  githubUrl String
  
  // Relacionamento 1 : N (Um perfil possui vários projetos)
  projects  Project[]
}

// 2. Entidade Project (Projeto)
model Project {
  id            Int          @id @default(autoincrement())
  title         String
  description   String
  repositoryUrl String
  
  // Chave estrangeira ligando ao Profile
  profileId     Int
  profile       Profile      @relation(fields: [profileId], references: [id])
  
  // Relacionamento 1 : N (Um projeto possui vários feedbacks)
  feedbacks     Feedback[]
  
  // Relacionamento N : N (Vários projetos usam várias tecnologias)
  technologies  Technology[]
}

// 3. Entidade Technology (Tecnologia)
model Technology {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  
  // Relacionamento N : N (Uma tecnologia está em vários projetos)
  projects Project[]
}

// 4. Entidade Feedback (Opinião)
model Feedback {
  id        Int     @id @default(autoincrement())
  comment   String
  
  // Chave estrangeira ligando ao Project
  projectId Int
  project   Project @relation(fields: [projectId], references: [id])
}
